DATABASE_URL="postgresql://hongcha:changeme@localhost:5432/hongcha"

# ต้องยาวอย่างน้อย 32 ตัวอักษร ไม่งั้น backend จะไม่ยอม start
# สร้างค่าใหม่: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changeme-ต้องยาวอย่างน้อย-32-ตัวอักษร"

PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# บัญชีแอดมินเริ่มต้น (ไม่บังคับ) — seed จะไม่เขียนทับบัญชีที่มีอยู่แล้ว
# รหัสผ่านต้องยาวอย่างน้อย 12 ตัวอักษร
# เปลี่ยนรหัสผ่านแอดมินภายหลังด้วย: node scripts/reset-admin-password.js <email> <รหัสใหม่>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# โหมดจำลอง forgot-password (แสดงลิงก์รีเซ็ตในหน้าเว็บแทนการส่งอีเมล)
# ต้องเป็น false บน production เสมอ — บัญชีแอดมินถูกกันไว้เสมอแม้เปิดโหมดนี้
DEMO_REVEAL_RESET_TOKEN=false
DEMO_RESET_EMAILS=
