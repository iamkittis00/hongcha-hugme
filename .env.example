# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไว้ ห้าม commit)
# docker compose อ่านไฟล์ .env ในโฟลเดอร์นี้อัตโนมัติ

# รหัสผ่านฐานข้อมูล Postgres ของ Docker ในเครื่อง
POSTGRES_PASSWORD=changeme

# กุญแจเซ็น JWT ต้องยาวอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่าเดียวกับ production
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-ต้องยาวอย่างน้อย-32-ตัวอักษร

# บัญชีแอดมินเริ่มต้น (ไม่ใส่ก็ได้ ถ้าไม่ใส่จะไม่สร้างบัญชีแอดมินให้)
# รหัสผ่านต้องยาวอย่างน้อย 12 ตัวอักษร และจะไม่เขียนทับบัญชีที่มีอยู่แล้ว
# ถ้าต้องการเปลี่ยนรหัสผ่านแอดมินภายหลัง ใช้ backend/scripts/reset-admin-password.js
ADMIN_EMAIL=
ADMIN_PASSWORD=

# โหมดจำลอง forgot-password: แสดงลิงก์รีเซ็ตในหน้าเว็บแทนการส่งอีเมลจริง
# ต้องเป็น false บน production เสมอ เปิดเฉพาะตอนเดโมให้ลูกค้าดูเท่านั้น
# บัญชีที่มีสิทธิ์แอดมินจะถูกกันไว้เสมอ แม้เปิดโหมดนี้ก็ตาม
DEMO_REVEAL_RESET_TOKEN=false
DEMO_RESET_EMAILS=
